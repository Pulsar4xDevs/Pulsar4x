  {
    "Type": "ComponentTemplate",
    "Payload": {
      "UniqueID": "spaceport",
      "Name": "Spaceport",
      "Formulas": {
        "Description": "A site-built port. It transfers cargo and stores half its size. Assembled in place. It cannot be freighted.",
        "Mass": "PropertyValue('Size') * 2.5",
        "Volume": "PropertyValue('Size')",
        "HTK": "0.5",
        "CrewReq": "Max(40, PropertyValue('Size') * 0.15)",
        "ResearchCost": "0",
        "CreditCost": "[Mass] * 0.12",
        "BuildPointCost": "8000"
      },
      "ResourceCost": {
        "iron": "[Mass] * 0.50",
        "space-crete": "[Mass] * 0.30",
        "stainless-steel": "[Mass] * 0.15",
        "copper": "[Mass] * 0.05"
      },
      "ComponentType":"Cargo Hold",
      "MountType": "PlanetInstallation",
      "CargoTypeID": "None",
      "IndustryTypeID": "installation-construction",
      "Properties": [
        {
          "Name": "Size",
          "DescriptionFormula": "'(Volume) - Larger facility transports more goods'",
          "GuiHint": "GuiSelectionMaxMinInt",
          "DataDict": {},
          "MaxFormula": "2000000",
          "MinFormula": "50000",
          "StepFormula": "100",
          "PropertyFormula": "100000"
        },
        {
          "Name": "Rate vs Range",
          "DescriptionFormula": "'How much shuttle space should be used for cargo vs fuel'",
          "GuiHint": "GuiSelectionMaxMinInt",
          "DataDict": {},
          "MaxFormula": "9",
          "MinFormula": "1",
          "StepFormula": "1",
          "PropertyFormula": "5"
        },
        {
          "Name": "Transfer Rate",
          "Units": "kg/s",
          "DescriptionFormula": "'The rate at which cargo can be loaded an unloaded from this facility to a target'",
          "GuiHint": "GuiTextDisplay",
          "PropertyFormula": "0.00075 * (PropertyValue('Size') * 0.5 + PropertyValue('Size') * 0.5 * PropertyValue('Rate vs Range') * 0.1)"
        },
        {
          "Name": "Transfer Range",
          "DescriptionFormula": "'How much deltaV can the shuttles housed by this facility expend to get a cargo load to a target'",
          "GuiHint": "GuiTextDisplay",
          "PropertyFormula": "1.0 * (PropertyValue('Size') * 0.5 - PropertyValue('Size') * 0.5 * PropertyValue('Rate vs Range') * 0.1)"
        },
        {
          "Name": "DBArgsXfer",
          "GuiHint": "None",
          "PropertyFormula": "AtbConstrArgs(PropertyValue('Transfer Rate'), PropertyValue('Transfer Range'))",
          "AttributeType": "Pulsar4X.Storage.CargoTransferAtb"
        },
        {
          "Name": "Stored Volume",
          "DescriptionFormula": "'Cargo volume this port keeps on the ground.'",
          "GuiHint": "GuiTextDisplay",
          "PropertyFormula": "PropertyValue('Size') * 0.5"
        },
        {
          "Name": "DBargsStor",
          "GuiHint": "None",
          "PropertyFormula": "AtbConstrArgs(UniqueID('general-storage'), PropertyValue('Stored Volume'))",
          "AttributeType": "Pulsar4X.Storage.CargoStorageAtb"
        }
      ]
    }
